//@version=5
indicator("Numerology Secret | RichRise", overlay=true, max_boxes_count=100, max_lines_count=10)

// --- 1. ПРОВЕРКА ТАЙМФРЕЙМА ---
// Разрешаем работу только на таймфреймах >= 1H (60 минут), а также на дневных, недельных и месячных.
bool isValidTF = timeframe.isseconds == false and (timeframe.isminutes == false or timeframe.multiplier >= 15)

// --- 2. ПОЛЬЗОВАТЕЛЬСКИЕ НАСТРОЙКИ ---
// Интерактивный выбор базовой цены (confirm=true позволяет кликнуть по графику)
float basePrice = input.price(0, title="Базовый экстремум (кликните на график)", confirm=true)
string extType  = input.string("Минимум (Low)", title="Тип экстремума", options=["Минимум (Low)", "Максимум (High)"])

// --- 3. МАССИВЫ ЗНАЧЕНИЙ (из скриншота ТЗ) ---
array<float> starts = array.from(8.0, 16.0, 25.0, 35.0, 47.0, 66.0, 80.0, 99.0, 120.0, 143.0, 167.0, 189.0)
array<float> ends   = array.from(10.0, 18.0, 27.0, 40.0, 52.0, 68.0, 85.0, 104.0, 126.0, 149.0, 175.0, 195.0)

// Переменные для хранения объектов графики (чтобы удалять их на новых тиках и не дублировать)
var box[] zones = array.new_box()
var line baseLine = na

// --- 4. ОСНОВНАЯ ЛОГИКА И ОТРИСОВКА ---
if not isValidTF
    // Вывод предупреждения, если таймфрейм ниже 1H
    var table warningTable = table.new(position.top_right, 1, 1)
    if barstate.islast
        table.cell(warningTable, 0, 0, "ВНИМАНИЕ:\nРекомендуется использовать индикатор на\nтаймфреймах от 15м и выше.", text_color=color.white, bgcolor=color.olive, text_size=size.normal)
else
    // Если таймфрейм корректный, переходим к расчетам
    if barstate.islast
        // Очищаем старые зоны при обновлении данных или перемещении точки
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                box.delete(array.get(zones, i))
            array.clear(zones)

        if not na(baseLine)
            line.delete(baseLine)

        // Отрисовка базового уровня для наглядности (синяя пунктирная линия)
        baseLine := line.new(bar_index, basePrice, bar_index + 1, basePrice, color=color.blue, width=1, style=line.style_dashed, extend=extend.both)

        bool isLow = extType == "Минимум (Low)"

        // Цикл построения зон
        for i = 0 to array.size(starts) - 1
            float offStart = array.get(starts, i)
            float offEnd   = array.get(ends, i)

            // Логика расчета направления
            // Если выбран Low, зоны строятся вверх (+). Если High, зоны строятся вниз (-).
            float pStart = isLow ? basePrice + offStart : basePrice - offStart
            float pEnd   = isLow ? basePrice + offEnd   : basePrice - offEnd

            // Визуальное отображение (градиент цвета для S/R)
            // Чем дальше зона, тем насыщеннее цвет (уменьшаем прозрачность)
            int transp = 100 - (i * 2)

            color zColor = isLow ? color.new(color.red, transp) : color.new(color.green, transp)
            color bColor = isLow ? color.new(color.red, 50)     : color.new(color.green, 50)

            // Создание S/R зоны
            box newZone = box.new(
                 left=bar_index,
                 top=math.max(pStart, pEnd),
                 right=bar_index + 1,
                 bottom=math.min(pStart, pEnd),
                 border_color=bColor,
                 border_width=1,
                 bgcolor=zColor,
                 extend=extend.both
                 )
            array.push(zones, newZone)
