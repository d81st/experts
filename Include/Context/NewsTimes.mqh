//+------------------------------------------------------------------+
//|                                                    NewsTimes.mqh |
//|                                                                  |
//|  Время выхода новостей (по умолчанию — NFP, отчёт по занятости   |
//|  США). Календарь MetaTrader в тестере не работает, поэтому даты  |
//|  заданы списком в коде (строковый входной параметр тестер        |
//|  обрезает); бот может добавить даты своим параметром. Время —    |
//|  серверное (Exness: UTC+0). NFP выходит в                        |
//|  8:30 по Нью-Йорку: 12:30 UTC летом (США на летнем времени),     |
//|  13:30 UTC зимой.                                                |
//|  Подключается к любому боту: как фильтр «не входить рядом с      |
//|  новостью» или как источник времени для торговли на выходе.      |
//+------------------------------------------------------------------+
#ifndef NEWSTIMES_MQH
#define NEWSTIMES_MQH

// Выходы NFP 2025–2026. 2025.10 — отчёт не вышел (закрытие правительства США),
// сентябрьский вышел 20 ноября, октябрь и ноябрь — 16 декабря. Даты с 2026.06 —
// по обычному графику (первая пятница; 2 июля — четверг перед праздником), их стоит
// сверить с календарём.
#define NEWS_NFP_DEFAULT "2025.01.10 13:30;2025.02.07 13:30;2025.03.07 13:30;2025.04.04 12:30;" \
                         "2025.05.02 12:30;2025.06.06 12:30;2025.07.03 12:30;2025.08.01 12:30;" \
                         "2025.09.05 12:30;2025.11.20 13:30;2025.12.16 13:30;" \
                         "2026.01.09 13:30;2026.02.11 13:30;2026.03.06 13:30;2026.04.03 12:30;" \
                         "2026.05.08 12:30;2026.06.05 12:30;2026.07.02 12:30;2026.08.07 12:30;" \
                         "2026.09.04 12:30;2026.10.02 12:30"

// Список "ГГГГ.ММ.ДД ЧЧ:ММ;…" → массив времён по возрастанию. Возвращает их число.
int NewsParseTimes(const string list, datetime &out[])
  {
   string parts[];
   const int n = StringSplit(list, ';', parts);
   ArrayResize(out, 0);
   for(int i = 0; i < n; i++)
     {
      string s = parts[i];
      StringTrimLeft(s);
      StringTrimRight(s);
      if(s == "")
         continue;
      if(StringLen(s) != 16)   // строго "ГГГГ.ММ.ДД ЧЧ:ММ": обрезанная строка не должна дать ложную дату
        {
         PrintFormat("⚠️ Новости: пропущена запись «%s» (нужно ГГГГ.ММ.ДД ЧЧ:ММ)", s);
         continue;
        }
      const datetime t = StringToTime(s);
      if(t <= 0)
        {
         PrintFormat("⚠️ Новости: не разобрана дата «%s»", s);
         continue;
        }
      const int k = ArraySize(out);
      ArrayResize(out, k + 1);
      out[k] = t;
     }
   ArraySort(out);
   return ArraySize(out);
  }

// Ближайшая новость, для которой now попадает в окно [t - before, t + after] (минуты).
// Возвращает её время или 0.
datetime NewsInWindow(const datetime &times[], const datetime now, const int minutesBefore, const int minutesAfter)
  {
   for(int i = 0; i < ArraySize(times); i++)
     {
      if(now < times[i] - minutesBefore * 60)
         return 0;   // список по возрастанию — дальше только позже
      if(now <= times[i] + minutesAfter * 60)
         return times[i];
     }
   return 0;
  }

#endif // NEWSTIMES_MQH
//+------------------------------------------------------------------+
