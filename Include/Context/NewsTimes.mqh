//+------------------------------------------------------------------+
//|                                                    NewsTimes.mqh |
//|                                                                  |
//|  Время выхода новостей (по умолчанию — NFP, отчёт по занятости   |
//|  США). Календарь MetaTrader в тестере не работает, поэтому даты  |
//|  заданы списком в коде (строковый входной параметр тестер        |
//|  обрезает); бот может добавить даты своим параметром. Время —    |
//|  серверное (Exness: UTC+0). NFP выходит в                        |
//|  8:30 по Нью-Йорку: 12:30 UTC летом (США на летнем времени),     |
//|  13:30 UTC зимой.                                                |
//|  Подключается к любому боту: как фильтр «не входить рядом с      |
//|  новостью» или как источник времени для торговли на выходе.      |
//+------------------------------------------------------------------+
#ifndef NEWSTIMES_MQH
#define NEWSTIMES_MQH

// Выходы NFP 2024–2026 (2024 — по обычному графику, сверить с календарём). 2025.10 — отчёт не вышел (закрытие правительства США),
// сентябрьский вышел 20 ноября, октябрь и ноябрь — 16 декабря. Даты с 2026.06 —
// по обычному графику (первая пятница; 2 июля — четверг перед праздником), их стоит
// сверить с календарём.
#define NEWS_NFP_DEFAULT "2024.01.05 13:30;2024.02.02 13:30;2024.03.08 13:30;2024.04.05 12:30;" \
                         "2024.05.03 12:30;2024.06.07 12:30;2024.07.05 12:30;2024.08.02 12:30;" \
                         "2024.09.06 12:30;2024.10.04 12:30;2024.11.01 12:30;2024.12.06 13:30;" \
                         "2025.01.10 13:30;2025.02.07 13:30;2025.03.07 13:30;2025.04.04 12:30;" \
                         "2025.05.02 12:30;2025.06.06 12:30;2025.07.03 12:30;2025.08.01 12:30;" \
                         "2025.09.05 12:30;2025.11.20 13:30;2025.12.16 13:30;" \
                         "2026.01.09 13:30;2026.02.11 13:30;2026.03.06 13:30;2026.04.03 12:30;" \
                         "2026.05.08 12:30;2026.06.05 12:30;2026.07.02 12:30;2026.08.07 12:30;" \
                         "2026.09.04 12:30;2026.10.02 12:30"

// CPI (индекс потребительских цен), 8:30 по Нью-Йорку. 2025: сентябрьский отчёт перенесён
// на 24 октября, октябрьский отменён, ноябрьский — 18 декабря (закрытие правительства США).
// 2026: январский перенесён на 13 февраля. Источник 2025–2026 — расписание BLS; 2024 — сверить.
#define NEWS_CPI_DEFAULT "2024.01.11 13:30;2024.02.13 13:30;2024.03.12 12:30;2024.04.10 12:30;" \
                         "2024.05.15 12:30;2024.06.12 12:30;2024.07.11 12:30;2024.08.14 12:30;" \
                         "2024.09.11 12:30;2024.10.10 12:30;2024.11.13 13:30;2024.12.11 13:30;" \
                         "2025.01.15 13:30;2025.02.12 13:30;2025.03.12 12:30;2025.04.10 12:30;" \
                         "2025.05.13 12:30;2025.06.11 12:30;2025.07.15 12:30;2025.08.12 12:30;" \
                         "2025.09.11 12:30;2025.10.24 12:30;2025.12.18 13:30;" \
                         "2026.01.13 13:30;2026.02.13 13:30;2026.03.11 12:30;2026.04.10 12:30;" \
                         "2026.05.12 12:30;2026.06.10 12:30;2026.07.14 12:30;2026.08.12 12:30;" \
                         "2026.09.11 12:30;2026.10.14 12:30;2026.11.10 13:30;2026.12.10 13:30"

// FOMC — решение по ставке, 14:00 по Нью-Йорку (второй день заседания).
#define NEWS_FOMC_DEFAULT "2024.01.31 19:00;2024.03.20 18:00;2024.05.01 18:00;2024.06.12 18:00;" \
                          "2024.07.31 18:00;2024.09.18 18:00;2024.11.07 19:00;2024.12.18 19:00;" \
                          "2025.01.29 19:00;2025.03.19 18:00;2025.05.07 18:00;2025.06.18 18:00;" \
                          "2025.07.30 18:00;2025.09.17 18:00;2025.10.29 18:00;2025.12.10 19:00;" \
                          "2026.01.28 19:00;2026.03.18 18:00;2026.04.29 18:00;2026.06.17 18:00;" \
                          "2026.07.29 18:00;2026.09.16 18:00;2026.10.28 18:00;2026.12.09 19:00"

// ISM Manufacturing PMI, 10:00 по Нью-Йорку: первый рабочий день месяца, в январе — второй.
#define NEWS_ISM_DEFAULT "2024.01.03 15:00;2024.02.01 15:00;2024.03.01 15:00;2024.04.01 14:00;" \
                         "2024.05.01 14:00;2024.06.03 14:00;2024.07.01 14:00;2024.08.01 14:00;" \
                         "2024.09.03 14:00;2024.10.01 14:00;2024.11.01 14:00;2024.12.02 15:00;" \
                         "2025.01.03 15:00;2025.02.03 15:00;2025.03.03 15:00;2025.04.01 14:00;" \
                         "2025.05.01 14:00;2025.06.02 14:00;2025.07.01 14:00;2025.08.01 14:00;" \
                         "2025.09.02 14:00;2025.10.01 14:00;2025.11.03 15:00;2025.12.01 15:00;" \
                         "2026.01.05 15:00;2026.02.02 15:00;2026.03.02 15:00;2026.04.01 14:00;" \
                         "2026.05.01 14:00;2026.06.01 14:00;2026.07.01 14:00;2026.08.03 14:00;" \
                         "2026.09.01 14:00;2026.10.01 14:00;2026.11.02 15:00;2026.12.01 15:00"

// Список "ГГГГ.ММ.ДД ЧЧ:ММ;…" → массив времён по возрастанию. Возвращает их число.
int NewsParseTimes(const string list, datetime &out[])
  {
   string parts[];
   const int n = StringSplit(list, ';', parts);
   ArrayResize(out, 0);
   for(int i = 0; i < n; i++)
     {
      string s = parts[i];
      StringTrimLeft(s);
      StringTrimRight(s);
      if(s == "")
         continue;
      if(StringLen(s) != 16)   // строго "ГГГГ.ММ.ДД ЧЧ:ММ": обрезанная строка не должна дать ложную дату
        {
         PrintFormat("⚠️ Новости: пропущена запись «%s» (нужно ГГГГ.ММ.ДД ЧЧ:ММ)", s);
         continue;
        }
      const datetime t = StringToTime(s);
      if(t <= 0)
        {
         PrintFormat("⚠️ Новости: не разобрана дата «%s»", s);
         continue;
        }
      const int k = ArraySize(out);
      ArrayResize(out, k + 1);
      out[k] = t;
     }
   ArraySort(out);
   return ArraySize(out);
  }

// Общий список выбранных новостей (+ свои даты extra) по возрастанию. Возвращает их число.
int NewsBuildList(const bool nfp, const bool cpi, const bool fomc, const bool ism, const string extra,
                  datetime &out[])
  {
   string list = extra;
   if(nfp)  list += ";" + NEWS_NFP_DEFAULT;
   if(cpi)  list += ";" + NEWS_CPI_DEFAULT;
   if(fomc) list += ";" + NEWS_FOMC_DEFAULT;
   if(ism)  list += ";" + NEWS_ISM_DEFAULT;
   return NewsParseTimes(list, out);
  }

// Ближайшая новость, для которой now попадает в окно [t - before, t + after] (минуты).
// Возвращает её время или 0.
datetime NewsInWindow(const datetime &times[], const datetime now, const int minutesBefore, const int minutesAfter)
  {
   for(int i = 0; i < ArraySize(times); i++)
     {
      if(now < times[i] - minutesBefore * 60)
         return 0;   // список по возрастанию — дальше только позже
      if(now <= times[i] + minutesAfter * 60)
         return times[i];
     }
   return 0;
  }

#endif // NEWSTIMES_MQH
//+------------------------------------------------------------------+
