//+------------------------------------------------------------------+
//|                                                    FiboZones.mqh |
//|                                                                  |
//|  Зоны Фибоначчи от волны или диапазона. Только геометрия: где    |
//|  вход (ближний край), дальний край (для стопа), цель и сторона   |
//|  сделки. Откуда взялась волна (зигзаг, диапазон Азии, прошлый    |
//|  день) — решает вызывающий код.                                  |
//+------------------------------------------------------------------+
#ifndef FIBOZONES_MQH
#define FIBOZONES_MQH

//+------------------------------------------------------------------+
//| FiboZone — сделка от зоны.                                       |
//|   dir   — +1 покупка, -1 продажа                                 |
//|   nearP — ближний к цене край (вход лимиткой)                    |
//|   farP  — дальний край (за ним — стоп)                           |
//|   tp    — цель                                                   |
//|   name  — подпись для журнала (заполняет бот)                    |
//+------------------------------------------------------------------+
struct FiboZone
  {
   int    dir;
   double nearP;
   double farP;
   double tp;
   string name;
  };

//+------------------------------------------------------------------+
//| FiboRetraceZone — откат волны start → end (по направлению волны):|
//| уровни отсчитываются от конца волны внутрь долями её длины;      |
//| цель — конец волны (линия 0).                                    |
//+------------------------------------------------------------------+
void FiboRetraceZone(const double start, const double end,
                     const double nearR, const double farR, FiboZone &z)
  {
   const double W = end - start;
   z.dir   = (W > 0.0) ? 1 : -1;
   z.nearP = end - nearR * W;
   z.farP  = end - farR * W;
   z.tp    = end;
  }

//+------------------------------------------------------------------+
//| FiboExtZone — зона за диапазоном [lo, hi] на разворот.           |
//|   above = true  — сверху: lo + r·R, продажа, цель — hi;          |
//|   above = false — снизу:  hi - r·R, покупка, цель — lo.          |
//| r > 1 (1.212, 1.618 …): зона лежит за пробитой границей.         |
//+------------------------------------------------------------------+
void FiboExtZone(const double hi, const double lo, const bool above,
                 const double nearR, const double farR, FiboZone &z)
  {
   const double R = hi - lo;
   if(above)
     { z.dir = -1; z.nearP = lo + nearR * R; z.farP = lo + farR * R; z.tp = hi; }
   else
     { z.dir = 1;  z.nearP = hi - nearR * R; z.farP = hi - farR * R; z.tp = lo; }
  }

#endif // FIBOZONES_MQH
//+------------------------------------------------------------------+
